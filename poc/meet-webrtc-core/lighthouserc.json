{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "npm run preview",
      "url": [
        "http://127.0.0.1:4173",
        "http://127.0.0.1:4173/r/test-room",
        "http://127.0.0.1:4173/r/test-room/join"
      ],
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless --no-sandbox --disable-gpu --disable-dev-shm-usage",
        "budgets": [
          {
            "resourceType": "total",
            "budget": 120
          },
          {
            "resourceType": "script",
            "budget": 50
          },
          {
            "resourceType": "css",
            "budget": 10
          },
          {
            "resourceType": "font",
            "budget": 5
          },
          {
            "resourceType": "image",
            "budget": 20
          }
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["off"],
        "categories:pwa": ["error", { "minScore": 0.9 }],
        "first-contentful-paint": ["error", { "maxNumericValue": 1800 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0 }],
        "speed-index": ["error", { "maxNumericValue": 2500 }],
        "interactive": ["error", { "maxNumericValue": 2500 }],
        "redirects": ["off"],
        "viewport": ["off"],
        "service-worker": ["error", { "minScore": 1 }],
        "installable-manifest": ["error", { "minScore": 1 }],
        "splash-screen": ["error", { "minScore": 1 }],
        "themed-omnibox": ["error", { "minScore": 1 }],
        "maskable-icon": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}