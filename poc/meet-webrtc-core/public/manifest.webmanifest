      "description": "Start a new secure meeting",
      "url": "/r/new",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+meet",
      "url": "/r/%s"
    }
  ]
